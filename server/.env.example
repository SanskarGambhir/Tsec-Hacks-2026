# ---- Core (required; the server refuses to start without these) ----
PORT=8000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/cooper

ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# Where the browser app runs. Used for CORS, invite links and the redirect
# after an email verification link is clicked.
FRONTEND_URL=http://localhost:5173

# Public URL of this API. Falls back to the request host when unset, which is
# wrong behind a proxy — set it explicitly in production.
SERVER_URL=http://localhost:8000

# Additional allowed browser origin, if you serve the app from somewhere else.
CORS_ORIGIN=

# ---- Sensitive data ----
# Keys the PAN hash. Set a dedicated value so rotating JWT secrets does not
# invalidate every stored PAN. Defaults to ACCESS_TOKEN_SECRET if unset.
PAN_HASH_SECRET=

# ---- Payments (Razorpay) ----
# Without these, deposits cannot be created or verified. The key id must match
# VITE_RAZORPAY_KEY_ID in the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email ----
# Any SMTP provider. Verification and password-reset mail is disabled without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Cooper <no-reply@yourdomain.com>"
MAIL_DOMAIN=yourdomain.com
APP_NAME=Cooper

# ---- SMS / WhatsApp (Twilio) ----
# Phone verification and WhatsApp invites are disabled without these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ---- AI ----
# Bill scanning and spending insights are disabled without this.
GEMINI_API_KEY=
